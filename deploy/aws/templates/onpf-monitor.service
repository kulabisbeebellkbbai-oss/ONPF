[Unit]
Description=ONPF safe operational health metrics
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=onpf
Group=onpf
UMask=0077
Environment=AWS_PAGER=
WorkingDirectory=/opt/onpf/current
ExecStart=/opt/onpf/current/.venv/bin/python /opt/onpf/current/deploy/aws/backup.py --config /etc/onpf/backup.json --monitor
TimeoutStartSec=120
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
RestrictSUIDSGID=true
CapabilityBoundingSet=
