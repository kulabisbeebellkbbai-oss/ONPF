ONPF_PUBLIC_HOST=onpf.example.org
ONPF_VOLUME_ID=vol-00000000000000000
ONPF_DATA_ROOT=/var/lib/onpf
ONPF_INSTANCE_PATH=/var/lib/onpf/instance
ONPF_DATABASE=/var/lib/onpf/instance/onpf.sqlite3
# Optional contact delivery is configured in the private setup JSON.
# ONPF_CONTACT_TO, ONPF_SMTP_HOST, ONPF_SMTP_PORT, ONPF_SMTP_FROM,
# ONPF_SMTP_USER and ONPF_SMTP_PASSWORD_FILE are generated when configured.
# Optional AI drafting settings persist in /etc/onpf/ai-drafting.env, loaded
# after this regenerated file by onpf.service. See docs/ai-drafting-setup.md.
# Keep the OpenAI provider key exclusively in the separate gateway environment.
